# ── Drone Flight Analytics — environment variables ─────────────────────────────
# Copy this file to .env and fill in the values before running docker compose.
#
#   cp .env.example .env
#
# .env is git-ignored. NEVER commit real secrets.

# ── Database ──────────────────────────────────────────────────────────────────
# Strong password for the PostgreSQL droneanalytics user.
DB_PASSWORD=change_me_in_production

# ── JWT ───────────────────────────────────────────────────────────────────────
# At least 32 random characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-this-with-a-real-random-secret-at-least-32-chars

# Token lifetime in seconds (default 86400 = 24 hours)
# JWT_EXPIRATION_SECONDS=86400

# ── Optional: webhook notifications ──────────────────────────────────────────
# Set WEBHOOK_ENABLED=true and supply a URL to receive POST notifications
# when a flight has anomalies or airspace violations.
# WEBHOOK_ENABLED=false
# WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── Optional: host port for the frontend ─────────────────────────────────────
# Default is port 80. Change if something else is already using it.
# FRONTEND_PORT=8888
